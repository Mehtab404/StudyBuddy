GROQ_API_KEY=your-groq-key-goes-here
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=study_guide
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Website(s) allowed to call this API, comma-separated, no trailing slash.
# Local development with `npm run dev` serves the frontend on port 3000. When deployed, use your frontend's URL,
# e.g. https://your-frontend.onrender.com
FRONTEND_ORIGIN=https://studybuddy-frontend-gu52.vercel.app

# ---- Optional (the defaults are fine) ----
# REVIEW_MODEL=openai/gpt-oss-20b   # a different model for the fact-checking reviewer (default: same as the generator)
# CHUNK_SIZE=1200                   # characters of new text per chunk
# CHUNK_OVERLAP=200                 # characters repeated from the previous chunk
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# JWT_EXPIRE_MINUTES=1440
# GUEST_EXPIRE_MINUTES=1440         # how long a guest session and its data last; 0 turns guest mode off
# ENABLE_DEBUG=true                 # turn on the /debug/* endpoints (local development only, never in production)
# TRUSTED_PROXY_HOPS=0              # reverse proxies in front of the app (Render: 1); used to find the visitor's IP
# RATE_LIMIT_ENABLED=false          # turn off per-client request limits (they are on by default)
# LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING or ERROR
